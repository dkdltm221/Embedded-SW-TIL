<Window x:Class="MVVM.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MVVM"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <StackPanel Orientation="Vertical">
        <RadioButton Content="male" GroupName="gender" IsChecked="{Binding IsMale}" />
        <RadioButton Content="female" GroupName="gender" IsChecked="{Binding IsFemale}" />
        <TextBlock Text="{Binding Result}" />
        <Grid>
            <TextBox x:Name="x" HorizontalAlignment="Left" Text="{Binding Num}" Height="72" Margin="36,55,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="230"/>

            <TextBox x:Name="y" HorizontalAlignment="Left" Text="{Binding Name}" Margin="36,176,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="230" Height="72"/>
         
            <Button Content="Button" Command="{Binding Save}" HorizontalAlignment="Center" Margin="0,294,0,0" VerticalAlignment="Top" Height="54" Width="96"/>
            <ListBox  ItemsSource="{Binding Persons}" HorizontalAlignment="Left" Height="224" Margin="462,55,0,0" VerticalAlignment="Top" Width="230">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" Margin="5"/>
                            <TextBlock Text="{Binding Num}" Margin="5"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </StackPanel>


</Window>
