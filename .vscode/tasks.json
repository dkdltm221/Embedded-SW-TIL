{
    "version":  "2.0.0",
    "tasks":  [
                  {
                      "label":  "C/C++: cl.exe build active file",
                      "problemMatcher":  [
                                             "$msCompile"
                                         ],
                      "command":  "powershell.exe",
                      "type":  "process",
                      "args":  [
                                   "-NoProfile",
                                   "-ExecutionPolicy",
                                   "Bypass",
                                   "-File",
                                   "${workspaceFolder}\\.vscode\\build.ps1",
                                   "-SourceFile",
                                   "${file}"
                               ],
                      "group":  {
                                    "kind":  "build",
                                    "isDefault":  true
                                }
                  }
              ]
}
